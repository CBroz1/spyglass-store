# The plain-HTTP front door, always mounted.
#
# On its own this is correct only where something in front terminates TLS — set
# SPYGLASS_STORE_EDGE_TRUSTED_PROXY to that hop. Otherwise add
# docker-compose.tls.yml, which keeps this listener for the container's health
# check and publishes 443 instead.

server {
    listen 8000;
    listen [::]:8000;
    server_name _;

    include /etc/nginx/conf.d/proxy.inc;
}
