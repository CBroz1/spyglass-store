# The body of the broker's server block, shared by both front doors so the
# limits exist once. Rendered to `proxy.inc` — a name conf.d/*.conf does not
# match — because it is included, never loaded on its own.

client_max_body_size 64k;

# The address of a proxy in front of this one, if there is one, so the limits
# key on the real caller. The default trusts nothing; a wide range lets a caller
# pick their own bucket by forging the header. See deploy/README.md.
set_real_ip_from ${SPYGLASS_STORE_EDGE_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

# DO NOT TURN THIS ON. The content route answers 302 to a presigned URL on the
# object store, a different origin by design. Rewriting that Location to this
# origin makes clients keep `Authorization` across the redirect, and the store
# then refuses every read. See deploy/README.md.
proxy_redirect off;

# HSTS is set per location, not once per server: nginx does not inherit
# `add_header` into a location that sets its own, and the two below set
# `Retry-After`. Dropping these lines silently un-protects those endpoints.
location = /api/v1/auth/device {
    limit_req zone=auth_start burst=${SPYGLASS_STORE_EDGE_DEVICE_BURST} nodelay;
    limit_req zone=auth_total burst=${SPYGLASS_STORE_EDGE_TOTAL_BURST} nodelay;
    add_header Retry-After $retry_after always;
    add_header Strict-Transport-Security $hsts_header always;
    proxy_pass http://broker;
}

location = /api/v1/auth/token {
    limit_req zone=auth_poll burst=${SPYGLASS_STORE_EDGE_POLL_BURST} nodelay;
    limit_req zone=auth_total burst=${SPYGLASS_STORE_EDGE_TOTAL_BURST} nodelay;
    # The broker sets its own Retry-After on a 428 while a login is pending;
    # this map is empty for that status, so the edge does not overwrite it.
    add_header Retry-After $retry_after always;
    add_header Strict-Transport-Security $hsts_header always;
    proxy_pass http://broker;
}

# Everything else is unlimited on purpose: those routes need a bearer token and
# are metered per account by the broker's quota. A streamed read re-follows the
# content redirect once per range request, which looks exactly like a flood.
location / {
    add_header Strict-Transport-Security $hsts_header always;
    proxy_pass http://broker;
}
