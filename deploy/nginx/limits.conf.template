# Rate limits for the unauthenticated login endpoints, which spend this
# deployment's shared GitHub client id. Numbers and reasoning: deploy/README.md.
#
# http context. Where they are applied is proxy.inc.template.

limit_req_zone $binary_remote_addr zone=auth_start:10m rate=${SPYGLASS_STORE_EDGE_DEVICE_RATE};

# The device flow polls this one every few seconds until the user approves, so
# an honest login sustains ~12r/m for as long as they take. A tight limit here
# breaks slow logins rather than stopping abuse.
limit_req_zone $binary_remote_addr zone=auth_poll:10m rate=${SPYGLASS_STORE_EDGE_POLL_RATE};

# Across all callers: per-address limits do nothing against a spread-out flood,
# and the GitHub budget is shared by everyone.
limit_req_zone $server_name zone=auth_total:1m rate=${SPYGLASS_STORE_EDGE_TOTAL_RATE};

# 429, not nginx's default 503: the contract documents 429 for throttling, and
# 503 tells a client to retry a service that is not down.
limit_req_status 429;
limit_req_log_level warn;

upstream broker {
    server broker:8000;
}

# HSTS only over TLS. `add_header` with an empty value emits nothing, so one
# map covers both front doors.
map $scheme $hsts_header {
    https   "max-age=31536000";
    default "";
}
