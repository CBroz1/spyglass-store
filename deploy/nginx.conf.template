# The edge in front of the broker, and the only place the unauthenticated
# endpoints are rate limited.
#
# TUNING THIS FILE WITHOUT EDITING IT
#
# Every limit below is a `${SPYGLASS_STORE_EDGE_*}` variable, set in `.env`
# alongside the rest of the deployment's configuration. The nginx image renders
# this template at startup (`/etc/nginx/templates/*.template` -> envsubst ->
# `/etc/nginx/conf.d/`), so changing a rate is an `.env` edit and a restart.
# `docker-compose.yml` gives every one of them a default, and
# `NGINX_ENVSUBST_FILTER` there restricts substitution to that prefix — so
# nginx's own `$binary_remote_addr` and friends are left alone.
#
# These are edge settings, not broker settings. The application never reads
# them, and there is nothing in `settings.py` to match: it must not look as
# though the broker is enforcing something it cannot. Hence the `_EDGE_` in the
# names.
#
# WHY HERE AND NOT IN THE APPLICATION
#
# `/auth/device` and `/auth/token` take no credential and proxy to GitHub on
# the broker's own client id, so an unthrottled caller exhausts the app's
# GitHub rate limit and denies logins to everyone — no account required.
#
# Limiting per caller means identifying callers by address, and behind a proxy
# the broker only sees the proxy. It would have to trust `X-Forwarded-For`,
# which is caller-supplied: without a count of trusted hops, anyone can prepend
# a fake address and get a fresh bucket per request. The broker records that
# header for audit and decides nothing on it (`guards.client_ip`), and the fix
# is not to start trusting it in the application — it is to limit at the hop
# that actually knows the peer address. That is this file.
#
# IF ANOTHER PROXY SITS IN FRONT OF THIS ONE
#
# ...a CDN, a load balancer, a cluster ingress — then `$binary_remote_addr` is
# *its* address and every user shares one bucket. Uncomment `set_real_ip_from`
# below with the exact address of that hop and nothing wider: the whole point
# is that the last untrusted address is the one that gets limited.

# One bucket per caller per endpoint, plus a service-wide ceiling. 10m holds
# ~160k addresses; nginx evicts the least recently used when it fills.
#
# Starting a login is a human action, and a rare one.
limit_req_zone $binary_remote_addr zone=auth_start:10m rate=${SPYGLASS_STORE_EDGE_DEVICE_RATE};

# Polling is not. GitHub's device flow has the client poll the token endpoint
# every `interval` seconds — 5 by default — for as long as the user takes to
# approve, so an honest client sustains 12r/m here for up to fifteen minutes.
# A limit tight enough to feel safe would break every slow login.
limit_req_zone $binary_remote_addr zone=auth_poll:10m rate=${SPYGLASS_STORE_EDGE_POLL_RATE};

# Per-address limits do nothing against a spread-out flood, and the asset being
# protected is shared: one GitHub rate limit for the whole deployment. So there
# is also a ceiling across all callers. At the poll rate above this is roughly
# twenty simultaneous logins; raise it for a larger deployment, and know that
# what you are raising is how much of the app's GitHub budget one flood can
# spend.
limit_req_zone $server_name zone=auth_total:1m rate=${SPYGLASS_STORE_EDGE_TOTAL_RATE};

# 429 rather than nginx's default 503: the contract in `openapi.yaml` documents
# 429 with `Retry-After` for throttling, and 503 tells a client to retry a
# service that is not actually down.
limit_req_status 429;
limit_req_log_level warn;

# Only if a proxy you control sits in front of this one. Name that hop exactly;
# a wide range here hands the choice of bucket back to the caller.
#
# set_real_ip_from 10.0.0.0/24;      # the address of that proxy, and only it
# real_ip_header    X-Forwarded-For;
# real_ip_recursive on;

upstream broker {
    # The compose service name. The broker is not published to the host — if it
    # were, every limit in this file could be skipped by addressing it
    # directly.
    server broker:8000;
}

server {
    listen 8000;
    server_name _;

    # Registrations are small JSON. Nothing legitimate posts more than this,
    # and file bytes never come through here at all.
    client_max_body_size 64k;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # DO NOT TURN THIS ON. `GET /file/{id}/content` answers 302 to a presigned
    # URL on the object store, a different origin by design. Rewriting that
    # Location to this server's origin would make clients keep their
    # `Authorization` header across the redirect, and the store answers those
    # with a complaint about a missing `x-amz-content-sha256` that reads
    # nothing like an auth error. See deploy/README.md.
    proxy_redirect off;

    # For the same reason there is no location for the object store here. It is
    # published at its own hostname, not a path under this one.

    location = /api/v1/auth/device {
        limit_req zone=auth_start burst=${SPYGLASS_STORE_EDGE_DEVICE_BURST} nodelay;
        limit_req zone=auth_total burst=${SPYGLASS_STORE_EDGE_TOTAL_BURST} nodelay;
        # `always`, so it is sent on the 429 as well as on a success.
        add_header Retry-After ${SPYGLASS_STORE_EDGE_RETRY_AFTER} always;
        proxy_pass http://broker;
    }

    location = /api/v1/auth/token {
        limit_req zone=auth_poll burst=${SPYGLASS_STORE_EDGE_POLL_BURST} nodelay;
        limit_req zone=auth_total burst=${SPYGLASS_STORE_EDGE_TOTAL_BURST} nodelay;
        add_header Retry-After ${SPYGLASS_STORE_EDGE_RETRY_AFTER} always;
        proxy_pass http://broker;
    }

    # Everything else is deliberately unlimited here. Those routes need a
    # bearer token, and what they cost is metered per account by the broker's
    # own volume quota. A request-rate limit on top would throttle the workload
    # this service exists for: a streamed read re-follows the content redirect
    # once per range request, which looks exactly like a flood and is not one.
    location / {
        proxy_pass http://broker;
    }
}
