# Copy this file to `.env` **beside it**, in `deploy/`, and fill it in:
#
#   cp deploy/env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up --build
#
# Compose reads `.env` from the compose file's directory, not from wherever you
# run the command, so a copy at the repository root is silently ignored and the
# required variables below turn up missing. If you keep one there anyway, name
# it: `docker compose --env-file .env -f deploy/docker-compose.yml up`.
#
# This file is named `env.example` rather than `.env.example` on purpose:
# `.gitignore` ignores `*.env*`, so a dotted name could not be committed and
# every operator would be guessing at the list below. Do not rename it, and do
# not put real values in it — `.env` is the file that holds those, and it is
# ignored.
#
# Values shown are the defaults. Delete a line and the default applies; the
# broker's own defaults live in `src/spyglass_store/settings.py`.

# ---------------------------------------------------------------------------
# Required. The broker will not start without these.
# ---------------------------------------------------------------------------

# The ServerHost MySQL instance, in DataJoint's own variables rather than broker
# settings — an admin who can already reach the instance needs nothing new.
#
# These have to be here even though your shell has a DataJoint config: the
# container cannot read your `~/.datajoint_config.json`.
DJ_HOST=mysql.example.org:3306
DJ_USER=
DJ_PASS=

# The OAuth app's client id, with device flow enabled and no scopes requested.
# Register one per deployment; see docs/src/github-app.md.
SPYGLASS_STORE_GITHUB_CLIENT_ID=

# Object store credentials. The bundled store comes up with whatever pair you
# put here, so any non-empty one works for a local trial.
SPYGLASS_STORE_S3_ACCESS_KEY=
SPYGLASS_STORE_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Object store. Defaults point at the bundled service in docker-compose.yml.
# ---------------------------------------------------------------------------

# The address signed into every presigned URL, so it must be one **clients**
# can reach — the broker redirects them to it and then steps out. An
# internal-only name means login and resolve work while every download fails.
#
# Leave it unset for the bundled store and the compose file uses the service
# name, `http://store:8080`, which is reachable from that network and nowhere
# else. That is enough to try the stack from a container on it; it is not
# enough for a client on your laptop. Point it at a real cluster, or at an
# address both sides resolve, before anyone else uses it.
#
# It must also be a different origin than the broker.
#SPYGLASS_STORE_S3_ENDPOINT_URL=https://rgw.example.org
SPYGLASS_STORE_S3_BUCKET=spyglass-store

# The three knobs implementations disagree on; deploy/README.md has a profile
# per backend. `auto` is a Cloudflare R2 requirement — for Ceph RGW this is the
# zonegroup name, for AWS a real region.
SPYGLASS_STORE_S3_REGION=us-east-1
SPYGLASS_STORE_S3_ADDRESSING_STYLE=path
SPYGLASS_STORE_S3_SIGNATURE_VERSION=s3v4

# Ask the store to verify uploaded bytes against the registered hash. The
# broker never sees the bytes, so this is the only place that check can happen.
# Turn it off only for a backend that rejects the header — and accept that
# content can then be registered under one hash and uploaded as another.
SPYGLASS_STORE_S3_ENFORCE_UPLOAD_CHECKSUM=true

# The broker's own public URL. Used only to warn at startup if it shares an
# origin with the object store, which breaks every read. Leave empty to skip.
SPYGLASS_STORE_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Limits and lifetimes. **The volume allowances are placeholders — set them
# deliberately before this carries real traffic.**
# ---------------------------------------------------------------------------

# Per account, over the window below. A guardrail against a runaway script, not
# an accounting system: a legitimate user should never approach it.
SPYGLASS_STORE_DOWNLOAD_TB_PER_DAY=20
SPYGLASS_STORE_UPLOAD_TB_PER_DAY=5
SPYGLASS_STORE_QUOTA_WINDOW_HOURS=24

# How long a signed URL stays valid. Short, because an issued URL cannot be
# revoked — the broker is out of the data path by then.
SPYGLASS_STORE_PRESIGNED_TTL_SECONDS=300

# How long a broker token lasts. A bearer credential, so a lifetime bounds what
# one leak costs; logging in again is a single command. Zero never expires.
SPYGLASS_STORE_TOKEN_TTL_DAYS=90

# Minimum GitHub account age before an unverified account may read. Accounts are
# free and instant, so this is what stops one person spreading the unverified
# allowance across many of them.
SPYGLASS_STORE_MIN_ACCOUNT_AGE_DAYS=30

# Require a caller claiming already-stored content to prove they hold the bytes.
# Without it, knowing a hash is enough to claim the content behind it. Only
# sensible to disable where every account is already trusted with every file.
SPYGLASS_STORE_REQUIRE_POSSESSION_PROOF=true

# MySQL schema for the broker's tables, kept apart from any Spyglass schema.
SPYGLASS_STORE_SCHEMA_PREFIX=store

# ---------------------------------------------------------------------------
# The edge. Rate limits for the two unauthenticated login endpoints, which
# spend this deployment's shared GitHub client id. Not broker settings — the
# application never reads these. See deploy/nginx/.
# ---------------------------------------------------------------------------

# Starting a login is rare and human.
SPYGLASS_STORE_EDGE_DEVICE_RATE=6r/m
SPYGLASS_STORE_EDGE_DEVICE_BURST=5

# Polling is not: the device flow polls every `interval` seconds — 5 by default
# — until the user approves, so an honest login sustains 12r/m for as long as
# they take. Tightening this breaks slow logins rather than stopping abuse.
SPYGLASS_STORE_EDGE_POLL_RATE=15r/m
SPYGLASS_STORE_EDGE_POLL_BURST=20

# The ceiling across all callers together. Per-address limits do nothing against
# a spread-out flood, and the GitHub budget is shared.
SPYGLASS_STORE_EDGE_TOTAL_RATE=240r/m
SPYGLASS_STORE_EDGE_TOTAL_BURST=40

# Seconds, sent as `Retry-After` on a throttled response. Raise a rate without
# its burst and a client sending a handful of requests together still gets one.
SPYGLASS_STORE_EDGE_RETRY_AFTER=60

# If a proxy you control sits in front of the edge, its address — so the limits
# key on the real caller instead of on that proxy. Name it **exactly**; the
# default trusts nothing, and a wide range lets a caller pick their own bucket
# by forging `X-Forwarded-For`.
SPYGLASS_STORE_EDGE_TRUSTED_PROXY=127.0.0.1

# ---------------------------------------------------------------------------
# TLS at the edge. Only read when you add docker-compose.tls.yml, and required
# then. Without either this or a TLS terminator in front, broker tokens and
# presigned URLs travel in the clear.
# ---------------------------------------------------------------------------

# The hostname the certificate is for. Must differ from the object store's.
SPYGLASS_STORE_EDGE_SERVER_NAME=

# The directory on *this host* holding the certificate, mounted read-only. A
# directory rather than two files, because a certificate is usually a symlink
# into a renewal directory.
SPYGLASS_STORE_EDGE_TLS_DIR=/etc/ssl/spyglass-store

# Paths *inside the container*, under the mount above.
SPYGLASS_STORE_EDGE_TLS_CERT=/etc/nginx/tls/fullchain.pem
SPYGLASS_STORE_EDGE_TLS_KEY=/etc/nginx/tls/privkey.pem
