{
  "ignorePaths": [
    "CHANGELOG.md",
    "**/*changelog.md"
  ],
  "ignoreRegExpList": [
    "/(`{3})[\\s\\S]+?\\1/g",
    "/`([\\s\\S]+?)`/g"
  ],
  "languageSettings": [
    {
      "languageId": "python",
      "includeRegExpList": [
        "/#.*/",
        "/('''|\"\"\")[^\\1]+?\\1/g"
      ]
    },
    {
      "languageId": "javascript",
      "includeRegExpList": [
        "CStyleComment"
      ]
    },
    {
      "languageId": "json",
      "includeRegExpList": [
        "CStyleComment"
      ]
    },
    {
      "languageId": "typescript",
      "includeRegExpList": [
        "CStyleComment"
      ]
    }
  ],
  "useGitignore": true,
  "words": [
    "Broz",
    "Ceph",
